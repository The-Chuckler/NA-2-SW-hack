0001CED8                            ; ---------------------------------------------------------------------------
0001CED8                            
0001CED8                            
0001CED8                            
0001CED8                             include "_inc/ArtLoadCues.asm"
0001CED8                            ; ---------------------------------------------------------------------------
0001CED8                            ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
0001CED8                            ;
0001CED8                            ; This struct array tells the engine where to find all the art associated with
0001CED8                            ; a particular zone. Each zone gets four longwords, in which it stores four
0001CED8                            ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
0001CED8                            ; bits). The assembled data looks something like this:
0001CED8                            ;
0001CED8                            ; aaBBBBBB
0001CED8                            ; ccDDDDDD
0001CED8                            ; EEEEEE
0001CED8                            ; ffgghhii
0001CED8                            ;
0001CED8                            ; aa = index for primary pattern load request list
0001CED8                            ; BBBBBB = unused, pointer to level art
0001CED8                            ; cc = index for secondary pattern load request list
0001CED8                            ; DDDDDD = pointer to 16x16 block mappings
0001CED8                            ; EEEEEE = pointer to 128x128 block mappings
0001CED8                            ; ff = unused, always 0
0001CED8                            ; gg = unused, music track
0001CED8                            ; hh = unused, palette
0001CED8                            ; ii = palette
0001CED8                            ;
0001CED8                            ; Nemesis refers to this as the "main level load block". However, that name implies
0001CED8                            ; that this is code (obviously, it isn't), or at least that it points to the level's
0001CED8                            ; collision, object and ring placement arrays (it only points to palettes and 16x16
0001CED8                            ; mappings although the 128x128 mappings do affect the actual level layout and collision)
0001CED8                            ; ---------------------------------------------------------------------------
0001CED8                            
0001CED8                            ; macro for declaring a "main level load block" (MLLB)
0001CED8                            levartptrs macro plc1,plc2,palette,art,map16x16,map128x128,music
0001CED8                            	dc.l art+(plc1<<24)
0001CED8                            	dc.l map16x16+(plc2<<24)
0001CED8                            	dc.l map128x128
0001CED8                            	dc.b 0,music,palette,palette
0001CED8                            	endm
0001CED8                            ;FOR IDIOTS THAT DONT UNDERSTAND:
0001CED8                            ;first number is the first PLC
0001CED8                            ;second number is second PLC
0001CED8                            ;third number is palette
0001CED8                            ;then tiles, blocks, chunks, and music
0001CED8                            ; MainLoadBlocks:
0001CED8                            LevelArtPointers:
0001CED8 0000 0000 0000 0000 0000+  		levartptrs  4,  5,  4, Nem_GHZ, Map16_GHZ, UnkComp_Map128_GHZ, bgm_GHZ	;   0 ; GHZ  ; GREEN HILL ZONE
0001CEE8 0000 0000 0000 0000 0000+  		levartptrs  6,  7,  5, Nem_MTZ, BM16_MTZ,  BM128_MTZ, bgm_LZ			;   1 ; LZ   ; LABYRINTH ZONE
0001CEF8 0000 0000 0000 0000 0000+  		levartptrs  8,  9,  6, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ		;   2 ; CPZ  ; CHEMICAL PLANT ZONE
0001CF08 0000 0000 0000 0000 0000+  		levartptrs $A, $B,  7, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ		;   3 ; EHZ  ; EMERALD HILL ZONE
0001CF18 0000 0000 0000 0000 0000+  		levartptrs $C, $D,  8, Nem_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ		;   4 ; HPZ  ; HIDDEN PALACE ZONE
0001CF28 0000 0000 0000 0000 0000+  		levartptrs $E, $F,  9, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SBZ		;   5 ; HTZ  ; HILL TOP ZONE
0001CF38 0000 0000 0000 0000 0000+  		levartptrs $22,$22,$13, Nem_WZ,  Map16_WZ,  Map128_WZ,  bgm_SBZ;0,  0,$13, Nem_WZ,  Map16_WZ,  Map128_WZ,  bgm_SBZ	;   6 ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
0001CF48 0000 0000 0000 0000 0000+  		levartptrs $23,$2B,$14, Nem_DHZ,  Map16_DHZ,  Map128_DHZ,  bgm_GHZ
0001CF58 0000 0000 0000 0000 0000+  		levartptrs $28,$28,$15, Nem_CNZ,  Map16_CNZ,  Map128_CNZ,  bgm_GHZ
0001CF68 0000 0000 0000 0000 0000+  		levartptrs $25,$2A,$16, Nem_OOZ,  Map16_OOZ,  Map128_OOZ,  bgm_GHZ
0001CF78 0000 0000 0000 0000 0000+  		levartptrs $26,$29,$17, Nem_NGHZ,  Map16_NGHZ,  Map128_NGHZ,  bgm_GHZ
0001CF88 0000 0000 0000 0000 0000+  		levartptrs $24,$27,$1A, Nem_SSZ,  Map16_SSZ,  Map128_SSZ,  bgm_GHZ
0001CF98                            ; ---------------------------------------------------------------------------
0001CF98                            ; PATTERN LOAD REQUEST LISTS
0001CF98                            ;
0001CF98                            ; Pattern load request lists are simple structures used to load
0001CF98                            ; Nemesis-compressed art for sprites.
0001CF98                            ;
0001CF98                            ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
0001CF98                            ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
0001CF98                            ;
0001CF98                            
0001CF98                            ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
0001CF98                            ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
0001CF98                            ; overflow and completely screw up the variables stored directly after the queue buffer.
0001CF98                            ; (in my experience this is a guaranteed crash or hang)
0001CF98                            ;
0001CF98                            ; Many levels queue more than 16 items overall, but they don't exceed the limit because
0001CF98                            ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
0001CF98                            ; process the first part before requesting the rest.
0001CF98                            ; ---------------------------------------------------------------------------
0001CF98                            
0001CF98                            ;---------------------------------------------------------------------------------------
0001CF98                            ; Table of pattern load request lists. Remember to use word-length data when adding lists
0001CF98                            ; otherwise you'll break the array.
0001CF98                            ;---------------------------------------------------------------------------------------
0001CF98                            plreq macro toVRAMaddr,fromROMaddr
0001CF98                            	dc.l	fromROMaddr		; art to load
0001CF98                            	dc.w	(toVRAMaddr<<5)		; VRAM address to load it at (multiplied by $20)
0001CF98                            	endm
0001CF98 0000 0000                  ArtLoadCues:	dc.w PLC_Main-ArtLoadCues,PLC_Main2-ArtLoadCues;0,1
0001CF9C 0000 0000                  		dc.w PLC_Explode-ArtLoadCues,PLC_GameOver-ArtLoadCues;2,3
0001CFA0 0000 0000                  		dc.w PLC_GHZ-ArtLoadCues,PLC_GHZ2-ArtLoadCues;4,5
0001CFA4 0000 0000                  		dc.w PLC_MTZ-ArtLoadCues,PLC_MTZ2-ArtLoadCues;6,7
0001CFA8 0000 0000                  		dc.w PLC_CPZ-ArtLoadCues,PLC_CPZ2-ArtLoadCues;8,9
0001CFAC 0000 0000                  		dc.w PLC_EHZ-ArtLoadCues,PLC_EHZ2-ArtLoadCues;$A,$B
0001CFB0 0000 0000                  		dc.w PLC_HPZ-ArtLoadCues,PLC_HPZ2-ArtLoadCues;$C,$D
0001CFB4 0000 0000                  		dc.w PLC_HTZ-ArtLoadCues,PLC_HTZ2-ArtLoadCues;$E,$F
0001CFB8 0000 0000                  		dc.w PLC_S1TitleCard-ArtLoadCues,PLC_Boss-ArtLoadCues;$10,$11
0001CFBC 0000 0000                  		dc.w PLC_Signpost-ArtLoadCues,PLC_S1SpecialStage-ArtLoadCues;10 and 11 seems like;$12,$13
0001CFC0 0000 0000                  		dc.w PLC_S1SpecialStage-ArtLoadCues,PLC_GHZAnimals-ArtLoadCues;12,13;$14,$15
0001CFC4 0000 0000                  		dc.w PLC_LZAnimals-ArtLoadCues,PLC_CPZAnimals-ArtLoadCues;14,15;$16,$17
0001CFC8 0000 0000                  		dc.w PLC_EHZAnimals-ArtLoadCues,PLC_HPZAnimals-ArtLoadCues;16,17;$18,$19
0001CFCC 0000 0000                  		dc.w PLC_HTZAnimals-ArtLoadCues,PLC_EHZAnimals-ArtLoadCues; pointers for zones 5 and 6 animals;$1A,$1B
0001CFD0 0000 0000                  		dc.w PLC_EHZAnimals-ArtLoadCues,PLC_EHZAnimals-ArtLoadCues; zones 7&8 animals;$1C,$1D
0001CFD4 0000 0000                  		dc.w PLC_EHZAnimals-ArtLoadCues,PLC_EHZAnimals-ArtLoadCues; zone 9,$A;$1E,$1F
0001CFD8 0000 0000                  		dc.w PLC_EHZAnimals-ArtLoadCues,PLC_EHZAnimals-ArtLoadCues; zone $B, no DEZ, or do i add it anyway?YES;$20,$21
0001CFDC 0000                       		dc.w PLC_WZ-ArtLoadCues;PLC_HTZAnimals-ArtLoadCues;LeftoverArt_Unknown-ArtLoadCues;18,19;$22
0001CFDE 0000 0000                  		dc.w PLC_DHZ-ArtLoadCues,PLC_SSZ-ArtLoadCues;LeftoverArt_Unknown+2-ArtLoadCues,LeftoverArt_Unknown+4-ArtLoadCues;1A,1B;$23,$24
0001CFE2 0000 0000                  		dc.w PLC_OOZ-ArtLoadCues,PLC_NGHZ-ArtLoadCues;LeftoverArt_Unknown+6-ArtLoadCues,LeftoverArt_Unknown+8-ArtLoadCues;$25,$26
0001CFE6 0000                       		dc.w PLC_SSZ-ArtLoadCues;,PLC_NGHZ-ArtLoadCues;$27; why are there 2 for ssz...
0001CFE8 0000 0000                  		dc.w PLC_CNZ-ArtLoadCues,PLC_NGHZ_2-ArtLoadCues;$28,$29
0001CFEC 0000 0000                  		dc.w PLC_OOZ_2-ArtLoadCues,PLC_DHZ_2-ArtLoadCues;$2A,$2B
0001CFF0 0000 0000                  		dc.w PLC_OOZ_2-ArtLoadCues,PLC_DHZ_2-ArtLoadCues;$2C,$2D
