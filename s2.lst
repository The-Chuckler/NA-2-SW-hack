0007A322 4A05                       		tst.b	d5		; Is it a duration?
0007A324 6A00                       		bpl.s	.gotduration	; Branch if yes
0007A326 534C                       		subq.w	#1,a4		; Put byte back
0007A328 6000 F4BE                  		bra.w	FinishTrackUpdate
