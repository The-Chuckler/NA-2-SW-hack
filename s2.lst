00079570                            ; ---------------------------------------------------------------------------
00079570                            ; Priority of sound. New music or SFX must have a priority higher than or equal
00079570                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
00079570                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
00079570                            ; any music or SFX can override it (as long as it can override whatever was
00079570                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
00079570                            ; will only override special SFX and music will only override music.
00079570                            ; ---------------------------------------------------------------------------
00079570                            ; SoundTypes:
00079570                            SoundPriorities:
00079570 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
0007957F 9090 9090 9090 9090 9090+  		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
0007958F 8070 7070 7070 7070 7070+  		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
0007959F 7060 7060 7070 7070 7070+  		dc.b $70,$60,$70,$60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$7F	; $B0
000795AF 6070 7070 7070 7070 7070+  		dc.b $60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70	; $C0
000795BF 8080 8080 8080 8080 8080+  		dc.b $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80	; $D0
000795CF 9090 9090 90               		dc.b $90,$90,$90,$90,$90                                            	; $E0
