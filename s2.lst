0000D9E0                            ; ---------------------------------------------------------------------------
0000D9E0                            ; Subroutine to make an object move and fall downward increasingly fast
0000D9E0                            ; This moves the object horizontally and vertically
0000D9E0                            ; and also applies gravity to its speed
0000D9E0                            ; ---------------------------------------------------------------------------
0000D9E0                            
0000D9E0                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000D9E0                            
0000D9E0                            ; ObjectFall:
0000D9E0                            ObjectMoveAndFall:
0000D9E0 2428 0008                  		move.l	8(a0),d2	; load x position
0000D9E4 2628 000C                  		move.l	$C(a0),d3	; load y position
0000D9E8 3028 0010                  		move.w	$10(a0),d0	; load x speed
0000D9EC 48C0                       		ext.l	d0
0000D9EE E180                       		asl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
0000D9F0 D480                       		add.l	d0,d2		; add x speed to x position
0000D9F2 3028 0012                  		move.w	$12(a0),d0	; load y speed
0000D9F6 0668 0038 0012             		addi.w	#$38,$12(a0)	; increase vertical speed (apply gravity)
0000D9FC 48C0                       		ext.l	d0
0000D9FE E180                       		asl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
0000DA00 D680                       		add.l	d0,d3		; add old y speed to y position
0000DA02 2142 0008                  		move.l	d2,8(a0)	; store new x position
0000DA06 2143 000C                  		move.l	d3,$C(a0)	; store new y position
0000DA0A 4E75                       		rts
0000DA0C                            ; End of function ObjectMoveAndFall
0000DA0C                            
0000DA0C                            ; ---------------------------------------------------------------------------
0000DA0C                            ; Subroutine translating object speed to update object position
0000DA0C                            ; This moves the object horizontally and vertically
0000DA0C                            ; but does not apply gravity to it
0000DA0C                            ; ---------------------------------------------------------------------------
0000DA0C                            
0000DA0C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000DA0C                            
0000DA0C                            ; SpeedToPos:
0000DA0C                            ObjectMove:
0000DA0C                            SpeedToPos:
0000DA0C 2428 0008                  		move.l	8(a0),d2	; load x position
0000DA10 2628 000C                  		move.l	$C(a0),d3	; load y position
0000DA14 3028 0010                  		move.w	$10(a0),d0	; load x speed
0000DA18 48C0                       		ext.l	d0
0000DA1A E180                       		asl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
0000DA1C D480                       		add.l	d0,d2		; add x speed to x position
0000DA1E 3028 0012                  		move.w	$12(a0),d0	; load y speed
0000DA22 48C0                       		ext.l	d0
0000DA24 E180                       		asl.l	#8,d0		; shift velocity to line up with the middle 16 bits of the 32-bit position
0000DA26 D680                       		add.l	d0,d3		; add old y speed to y position
0000DA28 2142 0008                  		move.l	d2,8(a0)	; store new x position
0000DA2C 2143 000C                  		move.l	d3,$C(a0)	; store new y position
0000DA30 4E75                       		rts
0000DA32                            ; End of function ObjectMove
