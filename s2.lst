00010166                            ; ===========================================================================
00010166                            ; loc_F590:
00010166                            SolidObject_OnScreenTest:
00010166 4A28 0001                  		tst.b	1(a0)
0001016A 6A00 0000                  		bpl.w	SolidObject_TestClearPush
0001016E                            ; loc_F598:
0001016E                            SolidObject_cont:
0001016E                            		; We now perform the x portion of a bounding box check.  To do this, we assume a
0001016E                            		; coordinate system where the x origin is at the object's left edge.
0001016E 3029 0008                  		move.w	8(a1),d0	; load Sonic's x position...
00010172 9068 0008                  		sub.w	8(a0),d0	; ... and calculate his x position relative to the object
00010176 D041                       		add.w	d1,d0		; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
00010178 6B00 0000                  		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
0001017C 3601                       		move.w	d1,d3
0001017E D643                       		add.w	d3,d3		; calculate object's width
00010180 B043                       		cmp.w	d3,d0
00010182 6200 0000                  		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
00010186                            		; We now perform the y portion of a bounding box check.  To do this, we assume a
00010186                            		; coordinate system where the y origin is at the highest y position relative to the object
00010186                            		; at which Sonic would still collide with it.  This point is
00010186                            		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
00010186                            		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
00010186                            		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
