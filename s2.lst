000795D4                            ; ---------------------------------------------------------------------------
000795D4                            ; Subroutine to update music more than once per frame
000795D4                            ; (Called by horizontal & vert. interrupts)
000795D4                            ; ---------------------------------------------------------------------------
000795D4                            
000795D4                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000795D4                            
000795D4                            ; sub_71B4C:
000795D4                            UpdateMusic:
000795D4 33FC 0100 00A1 1100        		stopZ80
000795DC 4E71                       		nop	
000795DE 4E71                       		nop	
000795E0 4E71                       		nop	
000795E2                            ; loc_71B5A:
000795E2                            .updateloop:
000795E2 0839 0000 00A1 1100        		btst	#0,(z80_bus_request).l		; Is the z80 busy?
000795EA 66F6                       		bne.s	.updateloop			; If so, wait
000795EC                            
000795EC 0839 0007 00A0 1FFD        		btst	#7,(z80_dac_status).l		; Is DAC accepting new samples?
000795F4 6700                       		beq.s	.driverinput			; Branch if yes
000795F6 33FC 0000 00A1 1100        		startZ80
000795FE 4E71                       		nop	
00079600 4E71                       		nop	
00079602 4E71                       		nop	
00079604 4E71                       		nop	
00079606 4E71                       		nop	
00079608 60CA                       		bra.s	UpdateMusic
0007960A                            ; ===========================================================================
0007960A                            ; loc_71B82:
0007960A                            .driverinput:
0007960A 4DF9 00FF F000             		lea	(v_snddriver_ram&$FFFFFF).l,a6
00079610 422E 000E                  		clr.b	f_voice_selector(a6)
00079614 4A2E 0003                  		tst.b	f_pausemusic(a6)		; is music paused?
00079618 6600 0000                  		bne.w	PauseMusic			; if yes, branch
0007961C 532E 0001                  		subq.b	#1,v_main_tempo_timeout(a6)	; Has main tempo timer expired?
00079620 6600                       		bne.s	.skipdelay
00079622 4EBA 0000                  		jsr	TempoWait(pc)
00079626                            ; loc_71B9E:
00079626                            .skipdelay:
00079626 102E 0004                  		move.b	v_fadeout_counter(a6),d0
0007962A 6700                       		beq.s	.skipfadeout
0007962C 4EBA 0000                  		jsr	DoFadeOut(pc)
00079630                            ; loc_71BA8:
00079630                            .skipfadeout:
00079630 4A2E 0024                  		tst.b	f_fadein_flag(a6)
00079634 6700                       		beq.s	.skipfadein
00079636 4EBA 0000                  		jsr	DoFadeIn(pc)
0007963A                            ; loc_71BB2:
0007963A                            .skipfadein:
0007963A                            		; DANGER! The following line only checks v_soundqueue0 and v_soundqueue1, breaking v_soundqueue2.
0007963A 4A6E 000A                  		tst.w	v_soundqueue0(a6)	; is a music or sound queued for played?
0007963E 6700                       		beq.s	.nosndinput		; if not, branch
00079640 4EBA 0000                  		jsr	CycleSoundQueue(pc)
00079644                            ; loc_71BBC:
00079644                            .nosndinput:
00079644 0C2E 0080 0009             		cmpi.b	#$80,v_sound_id(a6)	; is song queue set for silence (empty)?
0007964A 6700                       		beq.s	.nonewsound		; If yes, branch
0007964C 4EBA 0000                  		jsr	PlaySoundID(pc)
00079650                            ; loc_71BC8:
00079650                            .nonewsound:
00079650 4BEE 0040                  		lea	v_music_dac_track(a6),a5
00079654 4A15                       		tst.b	(a5)			; Is DAC track playing? (TrackPlaybackControl)
00079656 6A00                       		bpl.s	.dacdone		; Branch if not
00079658 4EBA 0000                  		jsr	DACUpdateTrack(pc)
0007965C                            ; loc_71BD4:
0007965C                            .dacdone:
0007965C 422E 0008                  		clr.b	f_updating_dac(a6)
00079660 7E05                       		moveq	#((v_music_fm_tracks_end-v_music_fm_tracks)/TrackSz)-1,d7	; 6 FM tracks
00079662                            ; loc_71BDA:
00079662                            .bgmfmloop:
00079662 DAFC 0030                  		adda.w	#TrackSz,a5
00079666 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00079668 6A00                       		bpl.s	.bgmfmnext		; Branch if not
0007966A 4EBA 0000                  		jsr	FMUpdateTrack(pc)
0007966E                            ; loc_71BE6:
0007966E                            .bgmfmnext:
0007966E 51CF FFF2                  		dbf	d7,.bgmfmloop
00079672                            
00079672 7E02                       		moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks
00079674                            ; loc_71BEC:
00079674                            .bgmpsgloop:
00079674 DAFC 0030                  		adda.w	#TrackSz,a5
00079678 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
0007967A 6A00                       		bpl.s	.bgmpsgnext		; Branch if not
0007967C 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00079680                            ; loc_71BF8:
00079680                            .bgmpsgnext:
00079680 51CF FFF2                  		dbf	d7,.bgmpsgloop
00079684                            
00079684 1D7C 0080 000E             		move.b	#$80,f_voice_selector(a6)			; Now at SFX tracks
0007968A 7E02                       		moveq	#((v_sfx_fm_tracks_end-v_sfx_fm_tracks)/TrackSz)-1,d7	; 3 FM tracks (SFX)
0007968C                            ; loc_71C04:
0007968C                            .sfxfmloop:
0007968C DAFC 0030                  		adda.w	#TrackSz,a5
00079690 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00079692 6A00                       		bpl.s	.sfxfmnext		; Branch if not
00079694 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00079698                            ; loc_71C10:
00079698                            .sfxfmnext:
00079698 51CF FFF2                  		dbf	d7,.sfxfmloop
0007969C                            
0007969C 7E02                       		moveq	#((v_sfx_psg_tracks_end-v_sfx_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks (SFX)
0007969E                            ; loc_71C16:
0007969E                            .sfxpsgloop:
0007969E DAFC 0030                  		adda.w	#TrackSz,a5
000796A2 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
000796A4 6A00                       		bpl.s	.sfxpsgnext		; Branch of not
000796A6 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
000796AA                            ; loc_71C22:
000796AA                            .sfxpsgnext:
000796AA 51CF FFF2                  		dbf	d7,.sfxpsgloop
000796AE                            		
000796AE 1D7C 0040 000E             		move.b	#$40,f_voice_selector(a6) ; Now at special SFX tracks
000796B4 DAFC 0030                  		adda.w	#TrackSz,a5
000796B8 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
000796BA 6A00                       		bpl.s	.specfmdone		; Branch if not
000796BC 4EBA 0000                  		jsr	FMUpdateTrack(pc)
000796C0                            ; loc_71C38:
000796C0                            .specfmdone:
000796C0 DAFC 0030                  		adda.w	#TrackSz,a5
000796C4 4A15                       		tst.b	(a5)			; Is track playing (TrackPlaybackControl)
000796C6 6A00                       		bpl.s	DoStartZ80		; Branch if not
000796C8 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
000796CC                            ; loc_71C44:
000796CC                            DoStartZ80:
000796CC 33FC 0000 00A1 1100        		startZ80
000796D4 4E75                       		rts	
