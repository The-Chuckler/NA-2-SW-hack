0007A086 1D7C 0080 0009             		move.b	#$80,v_sound_id(a6)	; set music to $80 (silence)
0007A08C                            		; DANGER! This silences ALL channels, even the ones being used
0007A08C                            		; by SFX, and not music! .sendfmnoteoff does this already, and
0007A08C                            		; doesn't affect SFX channels, either.
0007A08C                            		; This should be replaced with an 'rts'.
0007A08C 4EBA FF64                  		jsr	FMSilenceAll(pc)
0007A090 6000 0000                  		bra.w	PSGSilenceAll
0007A094                            		; DANGER! InitMusicPlayback, and Sound_PlayBGM for that matter,
0007A094                            		; don't do a very good job of setting up the music tracks.
0007A094                            		; Tracks that aren't defined in a music file's header don't have
0007A094                            		; their channels defined, meaning .sendfmnoteoff won't silence
0007A094                            		; hardware properly. In combination with removing the above
0007A094                            		; calls to FMSilenceAll/PSGSilenceAll, this will cause hanging
0007A094                            		; notes.
0007A094                            		; To fix this, I suggest using this code, instead of an 'rts':
0007A094                            		;lea	v_music_track_ram+TrackVoiceControl(a6),a1
0007A094                            		;lea	FMDACInitBytes(pc),a2
0007A094                            		;moveq	#((v_music_fmdac_tracks_end-v_music_fmdac_tracks)/TrackSz)-1,d1		; 7 DAC/FM tracks
0007A094                            		;bsr.s	.writeloop
0007A094                            		;lea	PSGInitBytes(pc),a2
0007A094                            		;moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d1	; 3 PSG tracks
0007A094                            
0007A094                            ;.writeloop:
0007A094                            		;move.b	(a2)+,(a1)		; Write track's channel byte
0007A094                            		;lea	TrackSz(a1),a1		; Next track
0007A094                            		;dbf	d1,.writeloop		; Loop for all DAC/FM/PSG tracks
0007A094                            
0007A094                            		;rts
0007A094                            	
0007A094                            ; End of function InitMusicPlayback
