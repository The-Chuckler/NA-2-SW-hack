0000353C                            ; Subroutine to generate a pseudo-random number in d0
0000353C                            ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
0000353C                            ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
0000353C                            ; ---------------------------------------------------------------------------
0000353C                            
0000353C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000353C                            
0000353C                            PseudoRandomNumber:
0000353C                            RandomNumber:
0000353C 2238 F636                  		move.l	($FFFFF636).w,d1
00003540 6600                       		bne.s	loc_2C9C
00003542 223C 2A6D 365A             		move.l	#$2A6D365A,d1
00003548                            
00003548                            loc_2C9C:
00003548                            		; set the high word of d0 to be the high word of the RNG
00003548                            		; and multiply the RNG by 41
00003548 2001                       		move.l	d1,d0
0000354A E581                       		asl.l	#2,d1
0000354C D280                       		add.l	d0,d1
0000354E E781                       		asl.l	#3,d1
00003550 D280                       		add.l	d0,d1
00003552                            
00003552                            		; add the low word of the RNG to the high word of the RNG
00003552                            		; and set the low word of d0 to be the result
00003552 3001                       		move.w	d1,d0
00003554 4841                       		swap	d1
00003556 D041                       		add.w	d1,d0
00003558 3200                       		move.w	d0,d1
0000355A 4841                       		swap	d1
0000355C                            
0000355C 21C1 F636                  		move.l	d1,($FFFFF636).w
00003560 4E75                       		rts
00003562                            ; End of function RandomNumber
