0007A3B6                            ; loc_7292E:
0007A3B6                            PSGDoVolFX:	; This can actually be made a bit more efficient, see the comments for more
0007A3B6 1C2D 0009                  		move.b	TrackVolume(a5),d6	; Get volume
0007A3BA 7000                       		moveq	#0,d0
0007A3BC 102D 000B                  		move.b	TrackVoiceIndex(a5),d0	; Get PSG tone
0007A3C0 6700                       		beq.s	SetPSGVolume
0007A3C2 2079 0007 942C             		movea.l	(Go_PSGIndex).l,a0
0007A3C8 5340                       		subq.w	#1,d0
0007A3CA E548                       		lsl.w	#2,d0
0007A3CC 2070 0000                  		movea.l	(a0,d0.w),a0
0007A3D0 102D 000C                  		move.b	TrackVolEnvIndex(a5),d0	; Get volume envelope index		; move.b	TrackVolEnvIndex(a5),d0
0007A3D4 1030 0000                  		move.b	(a0,d0.w),d0			; Volume envelope value			; addq.b	#1,TrackVolEnvIndex(a5)
0007A3D8 522D 000C                  		addq.b	#1,TrackVolEnvIndex(a5)	; Increment volume envelope index	; move.b	(a0,d0.w),d0
0007A3DC 0800 0007                  		btst	#7,d0				; Is volume envelope value negative?	; <-- makes this line redundant
0007A3E0 6700                       		beq.s	.gotflutter			; Branch if not				; but you gotta make this one a bpl
0007A3E2 0C00 0080                  		cmpi.b	#$80,d0				; Is it the terminator?			; Since this is the only check, you can take the optimisation a step further:
0007A3E6 6700                       		beq.s	VolEnvHold			; If so, branch				; Change the previous beq (bpl) to a bmi and make it branch to VolEnvHold to make these last two lines redundant
0007A3E8                            ; loc_72960:
0007A3E8                            .gotflutter:
0007A3E8 DC40                       		add.w	d0,d6		; Add volume envelope value to volume
0007A3EA 0C06 0010                  		cmpi.b	#$10,d6		; Is volume $10 or higher?
0007A3EE 6500                       		blo.s	SetPSGVolume	; Branch if not
0007A3F0 7C0F                       		moveq	#$F,d6		; Limit to silence and fall through
0007A3F2                            ; End of function PSGUpdateVolFX
