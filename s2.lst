0007A218                            ; ===========================================================================
0007A218                            ; ---------------------------------------------------------------------------
0007A218                            ; FM Note Values: b-0 to a#8
0007A218                            ;
0007A218                            ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
0007A218                            ; Notably, this differs from the PSG frequency table, which starts with C and
0007A218                            ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
0007A218                            ; instead of $81, meaning that the first frequency in the table ironically
0007A218                            ; corresponds to the 'rest' note. The only way to use this frequency in a
0007A218                            ; real note is to transpose the channel to a lower semitone.
0007A218                            ;
0007A218                            ; Rather than use a complete lookup table, other SMPS drivers such as
0007A218                            ; Sonic 3's compute the octave, and only store a single octave's worth of
0007A218                            ; notes in the table.
0007A218                            ;
0007A218                            ; Invalid transposition values will cause this table to be overflowed,
0007A218                            ; resulting in garbage data being used as frequency values. In drivers that
0007A218                            ; compute the octave instead, invalid transposition values merely cause the
0007A218                            ; notes to wrap-around (the note below the lowest note will be the highest
0007A218                            ; note). It's important to keep this in mind when porting buggy songs.
0007A218                            ; ---------------------------------------------------------------------------
0007A218                            ; word_72790: FM_Notes:
0007A218                            FMFrequencies:
0007A218 025E 0284 02AB 02D3 02FE+  		dc.w $025E,$0284,$02AB,$02D3,$02FE,$032D,$035C,$038F,$03C5,$03FF,$043C,$047C
0007A230 0A5E 0A84 0AAB 0AD3 0AFE+  		dc.w $0A5E,$0A84,$0AAB,$0AD3,$0AFE,$0B2D,$0B5C,$0B8F,$0BC5,$0BFF,$0C3C,$0C7C
0007A248 125E 1284 12AB 12D3 12FE+  		dc.w $125E,$1284,$12AB,$12D3,$12FE,$132D,$135C,$138F,$13C5,$13FF,$143C,$147C
0007A260 1A5E 1A84 1AAB 1AD3 1AFE+  		dc.w $1A5E,$1A84,$1AAB,$1AD3,$1AFE,$1B2D,$1B5C,$1B8F,$1BC5,$1BFF,$1C3C,$1C7C
0007A278 225E 2284 22AB 22D3 22FE+  		dc.w $225E,$2284,$22AB,$22D3,$22FE,$232D,$235C,$238F,$23C5,$23FF,$243C,$247C
0007A290 2A5E 2A84 2AAB 2AD3 2AFE+  		dc.w $2A5E,$2A84,$2AAB,$2AD3,$2AFE,$2B2D,$2B5C,$2B8F,$2BC5,$2BFF,$2C3C,$2C7C
0007A2A8 325E 3284 32AB 32D3 32FE+  		dc.w $325E,$3284,$32AB,$32D3,$32FE,$332D,$335C,$338F,$33C5,$33FF,$343C,$347C
0007A2C0 3A5E 3A84 3AAB 3AD3 3AFE+  		dc.w $3A5E,$3A84,$3AAB,$3AD3,$3AFE,$3B2D,$3B5C,$3B8F,$3BC5,$3BFF,$3C3C,$3C7C
0007A2D8                            
