0007A3F8 0815 0002                  		btst	#2,(a5)		; Is SFX overriding? (TrackPlaybackControl)
0007A3FC 6600                       		bne.s	locret_7298A	; Return if so
0007A3FE 0815 0004                  		btst	#4,(a5)		; Is track set to not attack next note? (TrackPlaybackControl)
0007A402 6600                       		bne.s	PSGCheckNoteTimeout ; Branch if yes
