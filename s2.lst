0001001E 43F8 B040                  		lea	($FFFFB040).w,a1	; a1=character ; now check collision with Tails
00010022 4A29 0001                  		tst.b	1(a1)
00010026 6A00 0000                  		bpl.w	locret_F490	; return if not Tails
0001002A 5206                       		addq.b	#1,d6
