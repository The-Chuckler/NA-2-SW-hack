000796D6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000796D6                            
000796D6                            ; sub_71C4E: UpdateDAC:
000796D6                            DACUpdateTrack:
000796D6 532D 000E                  		subq.b	#1,TrackDurationTimeout(a5)	; Has DAC sample timeout expired?
000796DA 6600                       		bne.s	.locret				; Return if not
000796DC 1D7C 0080 0008             		move.b	#$80,f_updating_dac(a6)		; Set flag to indicate this is the DAC
000796E2                            ;DACDoNext:
000796E2 286D 0004                  		movea.l	TrackDataPointer(a5),a4	; DAC track data pointer
000796E6                            ; loc_71C5E:
000796E6                            .sampleloop:
000796E6 7A00                       		moveq	#0,d5
000796E8 1A1C                       		move.b	(a4)+,d5	; Get next SMPS unit
000796EA 0C05 00E0                  		cmpi.b	#$E0,d5		; Is it a coord. flag?
000796EE 6500                       		blo.s	.notcoord	; Branch if not
000796F0 4EBA 0000                  		jsr	CoordFlag(pc)
000796F4 60F0                       		bra.s	.sampleloop
000796F6                            ; ===========================================================================
000796F6                            ; loc_71C6E:
000796F6                            .notcoord:
000796F6 4A05                       		tst.b	d5			; Is it a sample?
000796F8 6A00                       		bpl.s	.gotduration		; Branch if not (duration)
000796FA 1B45 0010                  		move.b	d5,TrackSavedDAC(a5)	; Store new sample
000796FE 1A1C                       		move.b	(a4)+,d5		; Get another byte
00079700 6A00                       		bpl.s	.gotduration		; Branch if it is a duration
