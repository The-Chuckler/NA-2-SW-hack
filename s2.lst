0007A1B6                            ; Strangely, despite this driver being SMPS 68k Type 1b,
0007A1B6                            ; WriteFMI and WriteFMII are the Type 1a versions.
0007A1B6                            ; In Sonic 1's prototype, they were the Type 1b versions.
0007A1B6                            ; I wonder why they were changed?
0007A1B6                            
0007A1B6                            ; sub_7272E:
0007A1B6                            WriteFMI:
0007A1B6 1439 00A0 4000             		move.b	(ym2612_a0).l,d2
0007A1BC 0802 0007                  		btst	#7,d2		; Is FM busy?
0007A1C0 66F4                       		bne.s	WriteFMI	; Loop if so
0007A1C2 13C0 00A0 4000             		move.b	d0,(ym2612_a0).l
0007A1C8 4E71                       		nop	
0007A1CA 4E71                       		nop	
0007A1CC 4E71                       		nop	
0007A1CE                            ; loc_72746:
