0007951C                            ; New tempos for songs during speed shoes
0007951C                            ; ---------------------------------------------------------------------------
0007951C                            ; DANGER! several songs will use the first few bytes of MusicIndex as their main
0007951C                            ; tempos while speed shoes are active. If you don't want that, you should add
0007951C                            ; their "correct" sped-up main tempos to the list.
0007951C                            ; byte_71A94:
0007951C                            SpeedUpIndex:
0007951C 07                         		dc.b 7		; GHZ
0007951D 72                         		dc.b $72	; LZ
0007951E 73                         		dc.b $73	; MZ
0007951F 26                         		dc.b $26	; SLZ
00079520 15                         		dc.b $15	; SYZ
00079521 08                         		dc.b 8		; SBZ
00079522 FF                         		dc.b $FF	; Invincibility
00079523 05                         		dc.b 5		; Extra Life
00079524                            		;dc.b ?		; Special Stage
00079524                            		;dc.b ?		; Title Screen
00079524                            		;dc.b ?		; Ending
00079524                            		;dc.b ?		; Boss
00079524                            		;dc.b ?		; FZ
00079524                            		;dc.b ?		; Sonic Got Through
00079524                            		;dc.b ?		; Game Over
00079524                            		;dc.b ?		; Continue Screen
00079524                            		;dc.b ?		; Credits
00079524                            		;dc.b ?		; Drowning
00079524                            		;dc.b ?		; Get Emerald
