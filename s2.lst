0007A334                            PSGSetFreq:
0007A334 0405 0081                  		subi.b	#$81,d5		; Convert to 0-based index
0007A338 6500                       		bcs.s	.restpsg	; If $80, put track at rest
0007A33A DA2D 0008                  		add.b	TrackTranspose(a5),d5 ; Add in channel transposition
0007A33E 0245 007F                  		andi.w	#$7F,d5		; Clear high byte and sign bit
0007A342 E34D                       		lsl.w	#1,d5
0007A344 41FA 0000                  		lea	PSGFrequencies(pc),a0
0007A348 3B70 5000 0010             		move.w	(a0,d5.w),TrackFreq(a5)	; Set new frequency
