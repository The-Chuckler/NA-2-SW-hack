0000148C                            ; ---------------------------------------------------------------------------
0000148C                            ; Subroutine to transfer a plane map to VRAM
0000148C                            ; ---------------------------------------------------------------------------
0000148C                            
0000148C                            ; control register:
0000148C                            ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
0000148C                            ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
0000148C                            ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
0000148C                            ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
0000148C                            ;
0000148C                            ;	A00-A15 - address
0000148C                            ;	CD0-CD3 - code
0000148C                            ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
0000148C                            ;	CD5 - DMA operation
0000148C                            ;
0000148C                            ;	Bits CD3-CD0:
0000148C                            ;	0000 - VRAM read
0000148C                            ;	0001 - VRAM write
0000148C                            ;	0011 - CRAM write
0000148C                            ;	0100 - VSRAM read
0000148C                            ;	0101 - VSRAM write
0000148C                            ;	1000 - CRAM read
0000148C                            ;
0000148C                            ; d0 = control register
0000148C                            ; d1 = width
0000148C                            ; d2 = heigth
0000148C                            ; a1 = source address
0000148C                            
0000148C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000148C                            
0000148C                            ; ShowVDPGraphics: PlaneMapToVRAM:
0000148C                            PlaneMapToVRAM_H40:
0000148C 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
00001492 283C 0080 0000             		move.l	#$800000,d4
00001498                            
00001498                            PlaneMapToVRAM_H40_LineLoop:
00001498 2D40 0004                  		move.l	d0,4(a6)
0000149C 3601                       		move.w	d1,d3
0000149E                            
0000149E                            PlaneMapToVRAM_H40_TileLoop:
0000149E 3C99                       		move.w	(a1)+,(a6)
000014A0 51CB FFFC                  		dbf	d3,PlaneMapToVRAM_H40_TileLoop
000014A4 D084                       		add.l	d4,d0
000014A6 51CA FFF0                  		dbf	d2,PlaneMapToVRAM_H40_LineLoop
000014AA 4E75                       		rts
000014AC                            ; End of function PlaneMapToVRAM_H40
000014AC                            
000014AC                             pusho    ; buffer local label symbol config
000014AC                                opt ws+  ; change local label symbol to '.'
000014AC                             include "_inc/DMA Queue.asm"
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ; MACRO ResetDMAQueue
000014AC                            ; Clears the DMA queue, discarding all previously-queued DMAs.
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
000014AC                            ; Performs all queued DMA transfers and clears the DMA queue.
000014AC                            ;
000014AC                            ; Output:
000014AC                            ; 	a1,a5	trashed
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ; ROUTINE InitDMAQueue
000014AC                            ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
000014AC                            ; Must be called before the queue is used, and the queue expects that only it
000014AC                            ; write to this region of RAM.
000014AC                            ;
000014AC                            ; Output:
000014AC                            ; 	a0,d0,d1	trashed
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
000014AC                            ; Queues a DMA with parameters given in registers.
000014AC                            ;
000014AC                            ; Options:
000014AC                            ; 	AssumeSourceAddressInBytes (default 1)
000014AC                            ; 	AssumeSourceAddressIsRAMSafe (default 0)
000014AC                            ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe=0))
000014AC                            ; 	Use128kbSafeDMA (default 0)
000014AC                            ; 	UseVIntSafeDMA (default 0)
000014AC                            ; Input:
000014AC                            ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
000014AC                            ; 		set to 0)
000014AC                            ; 	d2	Destination address
000014AC                            ; 	d3	Transfer length (in words)
000014AC                            ; Output:
000014AC                            ; 	d0,d1,d2,d3,a1	trashed
000014AC                            ;
000014AC                            ; With the default settings, runs in:
000014AC                            ; * 48(11/0) cycles if queue is full (DMA discarded)
000014AC                            ; * 184(29/9) cycles otherwise (DMA queued)
000014AC                            ;
000014AC                            ; With Use128kbSafeDMA = 1, runs in:
000014AC                            ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
000014AC                            ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
000014AC                            ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
000014AC                            ;   fills the queue (second piece is discarded)
000014AC                            ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
000014AC                            ;   space for both pieces (both pieces queued)
000014AC                            ;
000014AC                            ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
000014AC                            ;
000014AC                            ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
000014AC                            ; but only if the DMA is not entirely discarded. However, all callers must be
000014AC                            ; edited to make sure the adresss given is correct.
000014AC                            ;
000014AC                            ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
000014AC                            ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
000014AC                            ; discarded. However, all callers must be edited to make sure the adresss given
000014AC                            ; in the correct form. You can use the dmaSource function for that.
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ; MACRO QueueStaticDMA
000014AC                            ; Directly queues a DMA on the spot. Requires all parameters to be known at
000014AC                            ; assembly time; that is, no registers. Gives assembly errors when the DMA
000014AC                            ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
000014AC                            ;
000014AC                            ; Options:
000014AC                            ; 	UseVIntSafeDMA (default 0)
000014AC                            ; Input:
000014AC                            ; 	Source address (in bytes), transfer length (in bytes), destination address
000014AC                            ; Output:
000014AC                            ; 	d0,a1	trashed
000014AC                            ;
000014AC                            ; With the default settings, runs in:
000014AC                            ; * 32(7/0) cycles if queue is full (DMA discarded)
000014AC                            ; * 122(21/8) cycles otherwise (DMA queued)
000014AC                            ;
000014AC                            ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
000014AC                            ; ===========================================================================
000014AC                            ; option: AssumeSourceAddressInBytes
000014AC                            ;
000014AC                            ; This option makes the function work as a drop-in replacement of the original
000014AC                            ; functions. If you modify all callers to supply a position in words instead of
000014AC                            ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
000014AC =00000001                  AssumeSourceAddressInBytes = 1
000014AC                            ; ===========================================================================
000014AC                            ; option: AssumeSourceAddressIsRAMSafe
000014AC                            ;
000014AC                            ; This option (which is disabled by default) makes the DMA queue assume that the
000014AC                            ; source address is given to the function in a way that makes them safe to use
000014AC                            ; with RAM sources. You need to edit all callers to ensure this.
000014AC                            ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
000014AC =00000001                  AssumeSourceAddressIsRAMSafe = 1;0
000014AC                            ; ===========================================================================
000014AC                            ; option: UseRAMSourceSafeDMA
000014AC                            ;
000014AC                            ; This option (which is enabled by default) makes source addresses in RAM safe
000014AC                            ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
000014AC                            ; of source addresses (i.e., by ANDing them with $FFFFFF).
000014AC =00000000                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe=0)
000014AC                            ; ===========================================================================
000014AC                            ; option: Use128kbSafeDMA
000014AC                            ;
000014AC                            ; This option breaks DMA transfers that crosses a 128kB block into two. It is
000014AC                            ; disabled by default because you can simply align the art in ROM and avoid the
000014AC                            ; issue altogether. It is here so that you have a high-performance routine to do
000014AC                            ; the job in situations where you can't align it in ROM.
000014AC =00000000                  Use128kbSafeDMA = 0;1;0;1
000014AC                            ; ===========================================================================
000014AC                            ; option UseVIntSafeDMA
000014AC                            ;
000014AC                            ; Option to mask interrupts while updating the DMA queue. This fixes many race
000014AC                            ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
000014AC                            ; handle these race conditions would be to make unsafe callers (such as S3&K's
000014AC                            ; KosM decoder) prevent these by masking off interrupts before calling and then
000014AC                            ; restore interrupts after.
000014AC =00000000                  UseVIntSafeDMA = 0;1
000014AC                            ; ===========================================================================
000014AC                            
000014AC                            
000014AC                            ; Convenience macros, for increased maintainability of the code.
000014AC =00000027                  DMA = %100111
000014AC =00000021                  VRAM = %100001
000014AC                            ; Like vdpComm, but starting from an address contained in a register
000014AC =00000001                  vdpCommReg_defined = 1
000014AC                            vdpCommReg macro reg,type,rwd,clr
000014AC                            	lsl.l	#2,\reg							; Move high bits into (word-swapped) position, accidentally moving everything else
000014AC                            	if ((\type&\rwd)&3)<>0
000014AC                            		addq.w	#((\type&\rwd)&3),\reg			; Add upper access type bits
000014AC                            	endif
000014AC                            	ror.w	#2,\reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
000014AC                            	swap	\reg								; Put all bits in proper places
000014AC                            	if \clr <> 0
000014AC                            		andi.w	#3,\reg						; Strip whatever junk was in upper word of reg
000014AC                            	endif
000014AC                            	if ((\type&\rwd)&$FC)=$20
000014AC                            		tas.b	\reg							; Add in the DMA flag -- tas fails on memory, but works on registers
000014AC                            	elseif ((\type&\rwd)&$FC)<>0
000014AC                            		ori.w	#(((\type&\rwd)&$FC)<<2),\reg	; Add in missing access type bits
000014AC                            	endif
000014AC                            	endm
000014AC                            ; ---------------------------------------------------------------------------
000014AC =00000001                  intMacros_defined = 1
000014AC                            enableInts macro
000014AC                            	move	#$2300,sr
000014AC                            	endm
000014AC                            
000014AC                            disableInts macro
000014AC                            	move	#$2700,sr
000014AC                            	endm
000014AC                            ; ---------------------------------------------------------------------------
000014AC =00000001                  DMAEntry_defined = 1
000014AC                                    rsreset
000014AC =00000000                  DMAEntry.Reg94:		rs.b	1
000014AC                            			  
000014AC =00000001                  DMAEntry.Size:      rs.b    0
000014AC =00000001                  DMAEntry.SizeH:		rs.b	1
000014AC =00000002                  DMAEntry.Reg93:		rs.b	1
000014AC =00000003                  DMAEntry.Source:    rs.b    0
000014AC =00000003                  DMAEntry.SizeL:		rs.b	1
000014AC =00000004                  DMAEntry.Reg97:		rs.b	1
000014AC =00000005                  DMAEntry.SrcH:		rs.b	1
000014AC =00000006                  DMAEntry.Reg96:		rs.b	1
000014AC =00000007                  DMAEntry.SrcM:		rs.b	1
000014AC =00000008                  DMAEntry.Reg95:		rs.b	1
000014AC =00000009                  DMAEntry.SrcL:		rs.b	1
000014AC =0000000A                  DMAEntry.Command:	rs.l	1
000014AC =0000000E                  DMAEntry.len:   rs.w    0
000014AC                            ; ---------------------------------------------------------------------------
000014AC =00000012                  QueueSlotCount = (VDP_Command_Buffer_Slot-VDP_Command_Buffer)/DMAEntry.len
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            						
000014AC                            										   
000014AC                            									   
000014AC                            	  
000014AC                            																			 
000014AC                            							  
000014AC =00000001                  QueueStaticDMA_defined = 1
000014AC                            ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
000014AC                            ; at assembly time. Gives errors if DMA starts at an odd address, transfers
000014AC                            ; crosses a 128kB boundary, or has size 0.
000014AC                            QueueStaticDMA macro src,length,dest
000014AC                                local   len
000014AC                            		if ((\src)&1)<>0
000014AC                            			inform 3,"DMA queued from odd source \1!"
000014AC                            		endif
000014AC                            		if ((\length)&1)<>0
000014AC                            			inform 3,"DMA an odd number of bytes \2!"
000014AC                            		endif
000014AC                            		if (\length)=0
000014AC                            			inform 3,"DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
000014AC                            		endif
000014AC                            		if (((\src)+(\length)-1)>>17)<>((\src)>>17)
000014AC                            			inform 3,"DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
000014AC                            		endif
000014AC                            	  
000014AC                            	if UseVIntSafeDMA=1
000014AC                            		move.w	sr,-(sp)										; Save current interrupt mask
000014AC                            		disableInts												; Mask off interrupts
000014AC                            	endif ; UseVIntSafeDMA=1
000014AC                            	movea.w	(VDP_Command_Buffer_Slot).w,a1
000014AC                            	cmpa.w	#VDP_Command_Buffer_Slot,a1
000014AC                            	beq.s	.done												; Return if there's no more room in the buffer
000014AC                            	len: = ((length>>1)&$7FFF)
000014AC                                move.b	#(len>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
000014AC                            	move.l	#((len&$FF)<<24)|((src>>1)&$7FFFFF),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
000014AC                            	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
000014AC                            	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
000014AC                            	move.l	#$40000080,(a1)+						; Write VDP DMA command for destination address
000014AC                            	move.w	a1,(VDP_Command_Buffer_Slot).w						; Write next queue slot
000014AC                            .done:
000014AC                            	if UseVIntSafeDMA=1
000014AC                            		move.w	(sp)+,sr										; Restore interrupts to previous state
000014AC                            	endif ;UseVIntSafeDMA=1
000014AC                            	endm
000014AC                            
000014AC                                
000014AC                            
000014AC                            ; ---------------------------------------------------------------------------
000014AC                            ResetDMAQueue: macro
000014AC                            	move.w	#VDP_Command_Buffer,(VDP_Command_Buffer_Slot).w
000014AC                            	endm
000014AC                            ; ===========================================================================
000014AC                            
000014AC                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000014AC                            
000014AC                            ; sub_144E: DMA_68KtoVRAM: QueueCopyToVRAM: QueueVDPCommand:
000014AC                            DMA_68KtoVRAM:
000014AC                            Add_To_DMA_Queue:
000014AC                            QueueDMATransfer:
000014AC 3278 DCFC                  	movea.w	(VDP_Command_Buffer_Slot).w,a1
000014B0 B2FC DCFC                  	cmpa.w	#VDP_Command_Buffer_Slot,a1
000014B4 6700                       	beq.s	.done											; Return if there's no more room in the buffer
000014B6                            
000014B6 E289                       		lsr.l	#1,d1										; Source address is in words for the VDP registers
000014B8 03C9 0003                  	movep.l	d1,DMAEntry.Source(a1)							; Write source address; the useless top byte will be overwritten later
000014BC 7000                       	moveq	#0,d0											; We need a zero on d0
000014BE                            
000014BE                            	; It does not cross a 128kB boundary. So just finish writing it.
000014BE 0789 0001                  	movep.w	d3,DMAEntry.Size(a1)							; Write DMA length, overwriting useless top byte of source address
000014C2                            
000014C2                            .finishxfer:
000014C2                            	; Command to specify destination address and begin DMA
000014C2 3002                       	move.w	d2,d0											; Use the fact that top word of d0 is zero to avoid clearing on vdpCommReg
000014CE 43E9 000A                  	lea	DMAEntry.Command(a1),a1								; Seek to correct RAM address to store VDP DMA command
000014D2 22C0                       	move.l	d0,(a1)+										; Write VDP DMA command for destination address
000014D4 31C9 DCFC                  	move.w	a1,(VDP_Command_Buffer_Slot).w					; Write next queue slot
000014D8                            
000014D8                            .done:
000014D8 4E75                       	rts
000014DA                            ; ---------------------------------------------------------------------------
000014DA                            ; End of function QueueDMATransfer
000014DA                            ; ===========================================================================
000014DA                            
000014DA                            ; ---------------------------------------------------------------------------
000014DA                            ; Subroutine for issuing all VDP commands that were queued
000014DA                            ; (by earlier calls to QueueDMATransfer)
000014DA                            ; Resets the queue when it's done
000014DA                            ; ---------------------------------------------------------------------------
000014DA                            
000014DA                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000014DA                            
000014DA                            ; sub_14AC: CopyToVRAM: IssueVDPCommands: Process_DMA:
000014DA                            Process_DMA:
000014DA                            Process_DMA_Queue:
000014DA                            ProcessDMAQueue:
000014DA 3278 DCFC                  	movea.w	(VDP_Command_Buffer_Slot).w,a1
000014DE 4EE9 0000                  	jmp	.jump_table-VDP_Command_Buffer(a1)
000014E2                            ; ---------------------------------------------------------------------------
000014E2                            .jump_table:
000014E2 4E75                       	rts
000014E4                            	rept 6
000014E4                            		trap	#0											; Just in case
000014E4 4E40 4E40 4E40 4E40 4E40+  	endr
000014F0                            ; ---------------------------------------------------------------------------
000014F0 =00000001                      c: = 1
000014F0                            	rept QueueSlotCount
000014F0                            		lea	(vdp_control_port).l,a5
000014F0                            		lea	(VDP_Command_Buffer).w,a1
000014F0                            		if c<>QueueSlotCount
000014F0                            			bra.w	.jump0 - c*8
000014F0                            		endif
000014F0                                c: = c + 1
000015E8                            ; ---------------------------------------------------------------------------
000015E8                            	rept QueueSlotCount
000015E8                            		move.l	(a1)+,(a5)									; Transfer length
000015E8                            		move.l	(a1)+,(a5)									; Source address high
000015E8                            		move.l	(a1)+,(a5)									; Source address low + destination high
000015E8                            		move.w	(a1)+,(a5)									; Destination low, trigger DMA
000015E8 2A99 2A99 2A99 3A99 2A99+  	endr
00001678                            
00001678                            .jump0:
00001678 31FC DC00 DCFC             	ResetDMAQueue
0000167E 4E75                       	rts
00001680                            ; End of function ProcessDMAQueue
00001680                            ; ===========================================================================
00001680                            
00001680                            ; ---------------------------------------------------------------------------
00001680                            ; Subroutine for initializing the DMA queue.
00001680                            ; ---------------------------------------------------------------------------
00001680                            
00001680                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001680                            
00001680                            InitDMAQueue:
00001680 41F8 DC00                  	lea	(VDP_Command_Buffer).w,a0
00001684 7094                       	moveq	#-$6C,d0				; fast-store $94 (sign-extended) in d0
00001686 223C 9397 9695             	move.l	#$93979695,d1
0000168C =00000000                      c: = 0
0000168C                            	rept QueueSlotCount
0000168C                            		move.b	d0,c + DMAEntry.Reg94(a0)
0000168C                            		movep.l	d1,c + DMAEntry.Reg93(a0)
0000168C                                c: = c + DMAEntry.len
0000168C 1140 0000 03C8 0002 1140+  	endr
0000171C                            
0000171C 31FC DC00 DCFC             	ResetDMAQueue
00001722 4E75                       	rts
00001724                            ; End of function ProcessDMAQueue
00001724                            ; ===========================================================================
00001724                            ; ===========================================================================
00001724                             popo
00001724                            		include "_inc\Nemesis Decompression.asm"
00001724                            ; ---------------------------------------------------------------------------
00001724                            ; Nemesis decompression	subroutine, decompresses art directly to VRAM
00001724                            ; Inputs:
00001724                            ; a0 = art address
00001724                            
00001724                            ; For format explanation see http://info.sonicretro.org/Nemesis_compression
00001724                            ; ---------------------------------------------------------------------------
00001724                            
00001724                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001724                            
00001724                            ; Nemesis decompression to VRAM
00001724                            NemDec:
00001724 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001728 47F9 0000 0000             		lea	(NemPCD_WriteRowToVDP).l,a3	; write all data to the same location
0000172E 49F9 00C0 0000             		lea	(vdp_data_port).l,a4	; specifically, to the VDP data port
00001734 6000                       		bra.s	NemDecMain
00001736                            
00001736                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001736                            
00001736                            ; Nemesis decompression subroutine, decompresses art to RAM
00001736                            ; Inputs:
00001736                            ; a0 = art address
00001736                            ; a4 = destination RAM address
00001736                            NemDecToRAM:
00001736 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000173A 47F9 0000 0000             		lea	(NemPCD_WriteRowToRAM).l,a3 ; advance to the next location after each write
00001740                            
00001740                            NemDecMain:
00001740 43F8 AA00                  		lea	(Decomp_Buffer).w,a1
00001744 3418                       		move.w	(a0)+,d2	; get number of patterns
00001746 E34A                       		lsl.w	#1,d2
00001748 6400                       		bcc.s	loc_146A	; branch if the sign bit isn't set
0000174A D6FC 0000                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3	; otherwise the file uses XOR mode
0000174E                            
0000174E                            loc_146A:
0000174E E54A                       		lsl.w	#2,d2	; get number of 8-pixel rows in the uncompressed data
00001750 3A42                       		movea.w	d2,a5	; and store it in a5 because there aren't any spare data registers
00001752 7608                       		moveq	#8,d3	; 8 pixels in a pattern row
00001754 7400                       		moveq	#0,d2
00001756 7800                       		moveq	#0,d4
00001758 6100 0000                  		bsr.w	NemDec_BuildCodeTable
0000175C 1A18                       		move.b	(a0)+,d5	; get first byte of compressed data
0000175E E145                       		asl.w	#8,d5	; shift up by a byte
00001760 1A18                       		move.b	(a0)+,d5	; get second byte of compressed data
00001762 3C3C 0010                  		move.w	#$10,d6	; set initial shift value
00001766 6100                       		bsr.s	NemDec_ProcessCompressedData
00001768 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
0000176C 4E75                       		rts	
0000176E                            ; End of function NemDec
0000176E                            
0000176E                            ; ---------------------------------------------------------------------------
0000176E                            ; Part of the Nemesis decompressor, processes the actual compressed data
0000176E                            ; ---------------------------------------------------------------------------
0000176E                            
0000176E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000176E                            
0000176E                            
0000176E                            NemDec_ProcessCompressedData:
0000176E 3E06                       		move.w	d6,d7
00001770 5147                       		subq.w	#8,d7	; get shift value
00001772 3205                       		move.w	d5,d1
00001774 EE69                       		lsr.w	d7,d1	; shift so that high bit of the code is in bit position 7
00001776 0C01 00FC                  		cmpi.b	#%11111100,d1	; are the high 6 bits set?
0000177A 6400                       		bcc.s	NemPCD_InlineData	; if they are, it signifies inline data
0000177C 0241 00FF                  		andi.w	#$FF,d1
00001780 D241                       		add.w	d1,d1
00001782 1031 1000                  		move.b	(a1,d1.w),d0	; get the length of the code in bits
00001786 4880                       		ext.w	d0
00001788 9C40                       		sub.w	d0,d6	; subtract from shift value so that the next code is read next time around
0000178A 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
0000178E 6400                       		bcc.s	loc_14B2	; if not, branch
00001790 5046                       		addq.w	#8,d6
00001792 E145                       		asl.w	#8,d5
00001794 1A18                       		move.b	(a0)+,d5	; read next byte
00001796                            
00001796                            loc_14B2:
00001796 1231 1001                  		move.b	1(a1,d1.w),d1
0000179A 3001                       		move.w	d1,d0
0000179C 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000017A0 0240 00F0                  		andi.w	#$F0,d0
000017A4                            
000017A4                            NemPCD_ProcessCompressedData:
000017A4 E848                       		lsr.w	#4,d0	; get repeat count
000017A6                            
000017A6                            NemPCD_WritePixel:
000017A6 E98C                       		lsl.l	#4,d4	; shift up by a nybble
000017A8 8801                       		or.b	d1,d4	; write pixel
000017AA 5343                       		subq.w	#1,d3	; has an entire 8-pixel row been written?
000017AC 6600                       		bne.s	NemPCD_WritePixel_Loop	; if not, loop
000017AE 4ED3                       		jmp	(a3)	; otherwise, write the row to its destination, by doing a dynamic jump to NemPCD_WriteRowToVDP, NemDec_WriteAndAdvance, NemPCD_WriteRowToVDP_XOR, or NemDec_WriteAndAdvance_XOR
000017B0                            ; End of function NemDec_ProcessCompressedData
000017B0                            
000017B0                            
000017B0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000017B0                            
000017B0                            
000017B0                            NemPCD_NewRow:
000017B0 7800                       		moveq	#0,d4	; reset row
000017B2 7608                       		moveq	#8,d3	; reset nybble counter
000017B4                            
000017B4                            NemPCD_WritePixel_Loop:
000017B4 51C8 FFF0                  		dbf	d0,NemPCD_WritePixel
000017B8 60B4                       		bra.s	NemDec_ProcessCompressedData
000017BA                            ; ===========================================================================
000017BA                            
000017BA                            NemPCD_InlineData:
000017BA 5D46                       		subq.w	#6,d6	; 6 bits needed to signal inline data
000017BC 0C46 0009                  		cmpi.w	#9,d6
000017C0 6400                       		bcc.s	loc_14E4
000017C2 5046                       		addq.w	#8,d6
000017C4 E145                       		asl.w	#8,d5
000017C6 1A18                       		move.b	(a0)+,d5
000017C8                            
000017C8                            loc_14E4:
000017C8 5F46                       		subq.w	#7,d6	; and 7 bits needed for the inline data itself
000017CA 3205                       		move.w	d5,d1
000017CC EC69                       		lsr.w	d6,d1	; shift so that low bit of the code is in bit position 0
000017CE 3001                       		move.w	d1,d0
000017D0 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000017D4 0240 0070                  		andi.w	#$70,d0	; high nybble is repeat count for pixel
000017D8 0C46 0009                  		cmpi.w	#9,d6
000017DC 64C6                       		bcc.s	NemPCD_ProcessCompressedData
000017DE 5046                       		addq.w	#8,d6
000017E0 E145                       		asl.w	#8,d5
000017E2 1A18                       		move.b	(a0)+,d5
000017E4 60BE                       		bra.s	NemPCD_ProcessCompressedData
000017E6                            ; End of function NemPCD_NewRow
000017E6                            
000017E6                            ; ===========================================================================
000017E6                            
000017E6                            NemPCD_WriteRowToVDP:
000017E6 2884                       		move.l	d4,(a4)	; write 8-pixel row
000017E8 534D                       		subq.w	#1,a5
000017EA 380D                       		move.w	a5,d4	; have all the 8-pixel rows been written?
000017EC 66C2                       		bne.s	NemPCD_NewRow	; if not, branch
000017EE 4E75                       		rts		; otherwise the decompression is finished
000017F0                            ; ===========================================================================
000017F0                            NemPCD_WriteRowToVDP_XOR:
000017F0 B982                       		eor.l	d4,d2	; XOR the previous row by the current row
000017F2 2882                       		move.l	d2,(a4)	; and write the result
000017F4 534D                       		subq.w	#1,a5
000017F6 380D                       		move.w	a5,d4
000017F8 66B6                       		bne.s	NemPCD_NewRow
000017FA 4E75                       		rts	
000017FC                            ; ===========================================================================
000017FC                            
000017FC                            NemPCD_WriteRowToRAM:
000017FC 28C4                       		move.l	d4,(a4)+
000017FE 534D                       		subq.w	#1,a5
00001800 380D                       		move.w	a5,d4
00001802 66AC                       		bne.s	NemPCD_NewRow
00001804 4E75                       		rts	
00001806                            ; ===========================================================================
00001806                            NemPCD_WriteRowToRAM_XOR:
00001806 B982                       		eor.l	d4,d2
00001808 28C2                       		move.l	d2,(a4)+
0000180A 534D                       		subq.w	#1,a5
0000180C 380D                       		move.w	a5,d4
0000180E 66A0                       		bne.s	NemPCD_NewRow
00001810 4E75                       		rts	
00001812                            
00001812                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001812                            ; ---------------------------------------------------------------------------
00001812                            ; Part of the Nemesis decompressor, builds the code table (in RAM)
00001812                            ; ---------------------------------------------------------------------------
00001812                            
00001812                            
00001812                            NemDec_BuildCodeTable:
00001812 1018                       		move.b	(a0)+,d0	; read first byte
00001814                            
00001814                            NemBCT_ChkEnd:
00001814 0C00 00FF                  		cmpi.b	#$FF,d0	; has the end of the code table description been reached?
00001818 6600                       		bne.s	NemBCT_NewPALIndex	; if not, branch
0000181A 4E75                       		rts	; otherwise, this subroutine's work is done
0000181C                            ; ===========================================================================
0000181C                            
0000181C                            NemBCT_NewPALIndex:
0000181C 3E00                       		move.w	d0,d7
0000181E                            
0000181E                            NemBCT_Loop:
0000181E 1018                       		move.b	(a0)+,d0	; read next byte
00001820 0C00 0080                  		cmpi.b	#$80,d0	; sign bit being set signifies a new palette index
00001824 64EE                       		bcc.s	NemBCT_ChkEnd	; a bmi could have been used instead of a compare and bcc
00001826                            		
00001826 1200                       		move.b	d0,d1
00001828 0247 000F                  		andi.w	#$F,d7	; get palette index
0000182C 0241 0070                  		andi.w	#$70,d1	; get repeat count for palette index
00001830 8E41                       		or.w	d1,d7	; combine the two
00001832 0240 000F                  		andi.w	#$F,d0	; get the length of the code in bits
00001836 1200                       		move.b	d0,d1
00001838 E149                       		lsl.w	#8,d1
0000183A 8E41                       		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
0000183C 7208                       		moveq	#8,d1
0000183E 9240                       		sub.w	d0,d1	; is the code 8 bits long?
00001840 6600                       		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
00001842 1018                       		move.b	(a0)+,d0	; get code
00001844 D040                       		add.w	d0,d0	; each code gets a word-sized entry in the table
00001846 3387 0000                  		move.w	d7,(a1,d0.w)	; store the entry for the code
0000184A 60D2                       		bra.s	NemBCT_Loop	; repeat
0000184C                            ; ===========================================================================
0000184C                            
0000184C                            ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
0000184C                            ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
0000184C                            ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
0000184C                            ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
0000184C                            ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
0000184C                            ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
0000184C                            NemBCT_ShortCode:
0000184C 1018                       		move.b	(a0)+,d0	; get code
0000184E E368                       		lsl.w	d1,d0	; get index into code table
00001850 D040                       		add.w	d0,d0	; shift so that high bit is in bit position 7
00001852 7A01                       		moveq	#1,d5
00001854 E36D                       		lsl.w	d1,d5
00001856 5345                       		subq.w	#1,d5	; d5 = 2^d1 - 1
00001858                            
00001858                            NemBCT_ShortCode_Loop:
00001858 3387 0000                  		move.w	d7,(a1,d0.w)	; store entry
0000185C 5440                       		addq.w	#2,d0	; increment index
0000185E 51CD FFF8                  		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
00001862 60BA                       		bra.s	NemBCT_Loop
00001864                            ; End of function NemDec_BuildCodeTable
00001864                            ; End of function NemDec_BuildCodeTable
00001864                            
00001864                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001864                            ; ---------------------------------------------------------------------------
00001864                            ; Subroutine to load pattern load cues (aka to queue pattern load requests)
00001864                            ; ---------------------------------------------------------------------------
00001864                            
00001864                            ; ARGUMENTS
00001864                            ; d0 = index of PLC list (see ArtLoadCues)
00001864                            
00001864                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
00001864                            ;	  (or hacker) is responsible for making sure that no more than
00001864                            ;	  16 load requests are copied into the buffer.
00001864                            ;    _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
00001864                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
00001864                            
00001864                            ; PLCLoad:
00001864                            LoadPLC:
00001864 48E7 0060                  		movem.l	a1-a2,-(sp)
00001868 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
0000186E D040                       		add.w	d0,d0
00001870 3031 0000                  		move.w	(a1,d0.w),d0
00001874 43F1 0000                  		lea	(a1,d0.w),a1
00001878 45F8 F680                  		lea	(Plc_Buffer).w,a2
0000187C                            
0000187C                            loc_1688:
0000187C 4A92                       		tst.l	(a2)
0000187E 6700                       		beq.s	loc_1690
00001880 5C4A                       		addq.w	#6,a2
00001882 60F8                       		bra.s	loc_1688
00001884                            ; ---------------------------------------------------------------------------
00001884                            
00001884                            loc_1690:
00001884 3019                       		move.w	(a1)+,d0
00001886 6B00                       		bmi.s	loc_169C
00001888                            
00001888                            loc_1694:
00001888 24D9                       		move.l	(a1)+,(a2)+
0000188A 34D9                       		move.w	(a1)+,(a2)+
0000188C 51C8 FFFA                  		dbf	d0,loc_1694
00001890                            
00001890                            loc_169C:
00001890 4CDF 0600                  		movem.l	(sp)+,a1-a2
00001894 4E75                       		rts
00001896                            ; End of function LoadPLC
00001896                            
00001896                            
00001896                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001896                            ; Queue pattern load requests, but clear the PLQ first
00001896                            
00001896                            ; ARGUMENTS
00001896                            ; d0 = index of PLC list (see ArtLoadCues)
00001896                            
00001896                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
00001896                            ;	  (or hacker) is responsible for making sure that no more than
00001896                            ;	  16 load requests are copied into the buffer.
00001896                            ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
00001896                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
00001896                            
00001896                            LoadPLC2:
00001896 48E7 0060                  		movem.l	a1-a2,-(sp)
0000189A 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000018A0 D040                       		add.w	d0,d0
000018A2 3031 0000                  		move.w	(a1,d0.w),d0
000018A6 43F1 0000                  		lea	(a1,d0.w),a1
000018AA 6100                       		bsr.s	ClearPLC
000018AC 45F8 F680                  		lea	(Plc_Buffer).w,a2
000018B0 3019                       		move.w	(a1)+,d0
000018B2 6B00                       		bmi.s	loc_16C8
000018B4                            
000018B4                            loc_16C0:
000018B4 24D9                       		move.l	(a1)+,(a2)+
000018B6 34D9                       		move.w	(a1)+,(a2)+
000018B8 51C8 FFFA                  		dbf	d0,loc_16C0
000018BC                            
000018BC                            loc_16C8:
000018BC 4CDF 0600                  		movem.l	(sp)+,a1-a2
000018C0 4E75                       		rts
000018C2                            ; End of function LoadPLC2
000018C2                            
000018C2                            
000018C2                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000018C2                            
000018C2                            ; Clear the pattern load queue ($FFF680 - $FFF700)
000018C2                            
000018C2                            ClearPLC:
000018C2 45F8 F680                  		lea	(Plc_Buffer).w,a2
000018C6 701F                       		moveq	#$1F,d0
000018C8                            
000018C8                            loc_16D4:
000018C8 429A                       		clr.l	(a2)+
000018CA 51C8 FFFC                  		dbf	d0,loc_16D4
000018CE 4E75                       		rts
000018D0                            ; End of function ClearPLC
000018D0                            
000018D0                            
000018D0                            ; ---------------------------------------------------------------------------
000018D0                            ; Subroutine to use graphics listed in a pattern load cue
000018D0                            ; ---------------------------------------------------------------------------
000018D0                            
000018D0                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
000018D0                            
000018D0                            ; RunPLC:
000018D0                            RunPLC_RAM:
000018D0 4AB8 F680                  		tst.l	(Plc_Buffer).w
000018D4 6700                       		beq.s	locret_1730
000018D6 4A78 F6F8                  		tst.w	(Plc_Buffer_Reg18).w
000018DA 6600                       		bne.s	locret_1730
000018DC 2078 F680                  		movea.l	(Plc_Buffer).w,a0
000018E0 47FA FF04                  		lea	NemPCD_WriteRowToVDP(pc),a3
000018E4 4E71                       		nop
000018E6 43F8 AA00                  		lea	(Decomp_Buffer).w,a1
000018EA 3418                       		move.w	(a0)+,d2
000018EC 6A00                       		bpl.s	loc_16FE
000018EE D6FC 000A                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3
000018F2                            
000018F2                            loc_16FE:
000018F2 0242 7FFF                  		andi.w	#$7FFF,d2
000018F6 31C2 F6F8                  		move.w	d2,(Plc_Buffer_Reg18).w
000018FA 6100 FF16                  		bsr.w	NemDec_BuildCodeTable
000018FE 1A18                       		move.b	(a0)+,d5
00001900 E145                       		asl.w	#8,d5
00001902 1A18                       		move.b	(a0)+,d5
00001904 7C10                       		moveq	#$10,d6
00001906 7000                       		moveq	#0,d0
00001908 21C8 F680                  		move.l	a0,(Plc_Buffer).w
0000190C 21CB F6E0                  		move.l	a3,(Plc_Buffer_Reg0).w
00001910 21C0 F6E4                  		move.l	d0,(Plc_Buffer_Reg4).w
00001914 21C0 F6E8                  		move.l	d0,(Plc_Buffer_Reg8).w
00001918 21C0 F6EC                  		move.l	d0,(Plc_Buffer_RegC).w
0000191C 21C5 F6F0                  		move.l	d5,(Plc_Buffer_Reg10).w
00001920 21C6 F6F4                  		move.l	d6,(Plc_Buffer_Reg14).w
00001924                            
00001924                            locret_1730:
00001924 4E75                       		rts
00001926                            ; End of function RunPLC_RAM
00001926                            
00001926                            
00001926                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001926                            ; Process one PLC from the queue
00001926                            
00001926                            ; sub_1732:
00001926                            ProcessDPLC:
00001926 4A78 F6F8                  		tst.w	(Plc_Buffer_Reg18).w
0000192A 6700 0000                  		beq.w	locret_17CA
0000192E 31FC 0009 F6FA             		move.w	#9,(Plc_Buffer_Reg1A).w
00001934 7000                       		moveq	#0,d0
00001936 3038 F684                  		move.w	(Plc_Buffer+4).w,d0
0000193A 0678 0120 F684             		addi.w	#$120,(Plc_Buffer+4).w
00001940 6000                       		bra.s	ProcessDPLC_Main
