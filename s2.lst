0007A904                            Kos_Z80:
0007A904                            		; In this branch, the DAC driver is a binary blob. We do some
0007A904                            		; hackery here to manually patch some of its pointers. In the
0007A904                            		; AS branch, this driver is properly disassembled.
0007A904                            		incbin	"sound\z80.bin", 0, $15
0007A919 00                         		dc.b ((SegaPCM&$FF8000)/$8000)&1						; Least bit of bank ID (bit 15 of address)
0007A91A                            		incbin	"sound\z80.bin", $16, 6
0007A920 00                         		dc.b ((SegaPCM&$FF8000)/$8000)>>1						; ... the remaining bits of bank ID (bits 16-23)
0007A921                            		incbin	"sound\z80.bin", $1D, $93
0007A9B4 0000                       		dc.w ((SegaPCM&$FF)<<8)+((SegaPCM&$7F00)>>8)|$80				; Pointer to Sega PCM, relative to start of ROM bank (i.e., little_endian($8000 + SegaPCM&$7FFF)
0007A9B6                            		incbin	"sound\z80.bin", $B2, 1
0007A9B7 0000                       		dc.w (((SegaPCM_End-SegaPCM)&$FF)<<8)+(((SegaPCM_End-SegaPCM)&$FF00)>>8)	; ... the size of the Sega PCM (little endian)
0007A9B9                            		incbin	"sound\z80.bin", $B5, $16AB
0007C064                            		even
