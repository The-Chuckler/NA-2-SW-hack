0007A372 0815 0002                  		btst	#2,(a5)		; Is track being overridden? (TrackPlaybackControl)
0007A376 6600                       		bne.s	.locret		; Return if yes
0007A378 0815 0001                  		btst	#1,(a5)		; Is track at rest? (TrackPlaybackControl)
