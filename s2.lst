00000000                            
00000000                            align:	macro
00000000                            	if (narg=1)
00000000                            	dcb.b (\1-(*%\1))%\1,0
00000000                            	else
00000000                            	dcb.b (\1-(*%\1))%\1,\2
00000000                            	endc
00000000                            	endm
