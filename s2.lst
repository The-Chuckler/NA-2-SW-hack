0007A1CE 1439 00A0 4000             		move.b	(ym2612_a0).l,d2
0007A1D4 0802 0007                  		btst	#7,d2		; Is FM busy?
0007A1D8 66F4                       		bne.s	.waitloop	; Loop if so
0007A1DA                            
0007A1DA 13C1 00A0 4001             		move.b	d1,(ym2612_d0).l
0007A1E0 4E75                       		rts	
0007A1E2                            ; End of function WriteFMI
