00001A02                            ; ---------------------------------------------------------------------------
00001A02                            ; Enigma decompression algorithm
00001A02                            
00001A02                            ; input:
00001A02                            ;	d0 = starting art tile (added to each 8x8 before writing to destination)
00001A02                            ;	a0 = source address
00001A02                            ;	a1 = destination address
00001A02                            
00001A02                            ; usage:
00001A02                            ;	lea	(source).l,a0
00001A02                            ;	lea	(destination).l,a1
00001A02                            ;	move.w	#arttile,d0
00001A02                            ;	bsr.w	EniDec
00001A02                            
00001A02                            ; See http://www.segaretro.org/Enigma_compression for format description
00001A02                            ; ---------------------------------------------------------------------------
00001A02                            
00001A02                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001A02                            
00001A02                            
00001A02                            EniDec:
00001A02 48E7 FF7C                  		movem.l	d0-d7/a1-a5,-(sp)
00001A06 3640                       		movea.w	d0,a3		; store starting art tile
00001A08 1018                       		move.b	(a0)+,d0
00001A0A 4880                       		ext.w	d0
00001A0C 3A40                       		movea.w	d0,a5		; store number of bits in inline copy value
00001A0E 1818                       		move.b	(a0)+,d4
00001A10 E70C                       		lsl.b	#3,d4		; store PCCVH flags bitfield
00001A12 3458                       		movea.w	(a0)+,a2
00001A14 D4CB                       		adda.w	a3,a2		; store incremental copy word
00001A16 3858                       		movea.w	(a0)+,a4
00001A18 D8CB                       		adda.w	a3,a4		; store literal copy word
00001A1A 1A18                       		move.b	(a0)+,d5
00001A1C E145                       		asl.w	#8,d5
00001A1E 1A18                       		move.b	(a0)+,d5	; get first word in format list
00001A20 7C10                       		moveq	#16,d6		; initial shift value
00001A22                            ; loc_173E:
00001A22                            Eni_Loop:
00001A22 7007                       		moveq	#7,d0		; assume a format list entry is 7 bits
00001A24 3E06                       		move.w	d6,d7
00001A26 9E40                       		sub.w	d0,d7
00001A28 3205                       		move.w	d5,d1
00001A2A EE69                       		lsr.w	d7,d1
00001A2C 0241 007F                  		andi.w	#$7F,d1		; get format list entry
00001A30 3401                       		move.w	d1,d2		; and copy it
00001A32 0C41 0040                  		cmpi.w	#$40,d1		; is the high bit of the entry set?
00001A36 6400                       		bhs.s	.sevenbitentry
00001A38 7006                       		moveq	#6,d0		; if it isn't, the entry is actually 6 bits
00001A3A E24A                       		lsr.w	#1,d2
00001A3C                            ; loc_1758:
00001A3C                            .sevenbitentry:
00001A3C 6100 0000                  		bsr.w	EniDec_FetchByte
00001A40 0242 000F                  		andi.w	#$F,d2		; get repeat count
00001A44 E849                       		lsr.w	#4,d1
00001A46 D241                       		add.w	d1,d1
00001A48 4EFB 1000                  		jmp	EniDec_Index(pc,d1.w)
00001A4C                            ; End of function EniDec
00001A4C                            
00001A4C                            ; ===========================================================================
00001A4C                            ; loc_1768:
00001A4C                            EniDec_00:
00001A4C 32CA                       .loop:		move.w	a2,(a1)+	; copy incremental copy word
00001A4E 524A                       		addq.w	#1,a2		; increment it
00001A50 51CA FFFA                  		dbf	d2,.loop	; repeat
00001A54 60CC                       		bra.s	Eni_Loop
00001A56                            ; ===========================================================================
00001A56                            ; loc_1772:
00001A56                            EniDec_01:
00001A56 32CC                       .loop:		move.w	a4,(a1)+	; copy literal copy word
00001A58 51CA FFFC                  		dbf	d2,.loop	; repeat
00001A5C 60C4                       		bra.s	Eni_Loop
00001A5E                            ; ===========================================================================
00001A5E                            ; loc_177A:
00001A5E                            EniDec_100:
00001A5E 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001A62                            ; loc_177E:
00001A62 32C1                       .loop:		move.w	d1,(a1)+	; copy inline value
00001A64 51CA FFFC                  		dbf	d2,.loop	; repeat
00001A68                            
00001A68 60B8                       		bra.s	Eni_Loop
00001A6A                            ; ===========================================================================
00001A6A                            ; loc_1786:
00001A6A                            EniDec_101:
00001A6A 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001A6E                            ; loc_178A:
00001A6E 32C1                       .loop:		move.w	d1,(a1)+	; copy inline value
00001A70 5241                       		addq.w	#1,d1		; increment
00001A72 51CA FFFA                  		dbf	d2,.loop	; repeat
00001A76                            
00001A76 60AA                       		bra.s	Eni_Loop
00001A78                            ; ===========================================================================
00001A78                            ; loc_1794:
00001A78                            EniDec_110:
00001A78 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001A7C                            ; loc_1798:
00001A7C 32C1                       .loop:		move.w	d1,(a1)+	; copy inline value
00001A7E 5341                       		subq.w	#1,d1		; decrement
00001A80 51CA FFFA                  		dbf	d2,.loop	; repeat
00001A84                            
00001A84 609C                       		bra.s	Eni_Loop
00001A86                            ; ===========================================================================
00001A86                            ; loc_17A2:
00001A86                            EniDec_111:
00001A86 0C42 000F                  		cmpi.w	#$F,d2
00001A8A 6700                       		beq.s	EniDec_Done
00001A8C                            ; loc_17A8:
00001A8C 6100 0000                  .loop:		bsr.w	EniDec_FetchInlineValue	; fetch new inline value
00001A90 32C1                       		move.w	d1,(a1)+	; copy it
00001A92 51CA FFF8                  		dbf	d2,.loop	; and repeat
00001A96                            
00001A96 608A                       		bra.s	Eni_Loop
00001A98                            ; ===========================================================================
00001A98                            ; loc_17B4:
00001A98                            EniDec_Index:
00001A98 60B2                       		bra.s	EniDec_00
00001A9A 60B0                       		bra.s	EniDec_00
00001A9C 60B8                       		bra.s	EniDec_01
00001A9E 60B6                       		bra.s	EniDec_01
00001AA0 60BC                       		bra.s	EniDec_100
00001AA2 60C6                       		bra.s	EniDec_101
00001AA4 60D2                       		bra.s	EniDec_110
00001AA6 60DE                       		bra.s	EniDec_111
00001AA8                            ; ===========================================================================
00001AA8                            ; loc_17C4:
00001AA8                            EniDec_Done:
00001AA8 5348                       		subq.w	#1,a0		; go back by one byte
00001AAA 0C46 0010                  		cmpi.w	#16,d6		; were we going to start on a completely new byte?
00001AAE 6600                       		bne.s	.notnewbyte	; if not, branch
00001AB0 5348                       		subq.w	#1,a0		; and another one if needed
00001AB2                            ; loc_17CE:
00001AB2                            .notnewbyte:
00001AB2 3008                       		move.w	a0,d0
00001AB4 E248                       		lsr.w	#1,d0		; are we on an odd byte?
00001AB6 6400                       		bcc.s	.evenbyte	; if not, branch
00001AB8 5248                       		addq.w	#1,a0		; ensure we're on an even byte
00001ABA                            ; loc_17D6:
00001ABA                            .evenbyte:
00001ABA 4CDF 3EFF                  		movem.l	(sp)+,d0-d7/a1-a5
00001ABE 4E75                       		rts	
00001AC0                            
00001AC0                            ; ---------------------------------------------------------------------------
00001AC0                            ; Part of the Enigma decompressor
00001AC0                            ; Fetches an inline copy value and stores it in d1
00001AC0                            ; ---------------------------------------------------------------------------
00001AC0                            
00001AC0                            ; =============== S U B R O U T I N E =======================================
00001AC0                            
00001AC0                            ; loc_17DC:
00001AC0                            EniDec_FetchInlineValue:
00001AC0 360B                       		move.w	a3,d3		; copy starting art tile
00001AC2 1204                       		move.b	d4,d1		; copy PCCVH bitfield
00001AC4 D201                       		add.b	d1,d1		; is the priority bit set?
00001AC6 6400                       		bcc.s	.skippriority	; if not, branch
00001AC8 5346                       		subq.w	#1,d6
00001ACA 0D05                       		btst	d6,d5		; is the priority bit set in the inline render flags?
00001ACC 6700                       		beq.s	.skippriority	; if not, branch
00001ACE 0043 8000                  		ori.w	#$8000,d3	; otherwise set priority bit in art tile
00001AD2                            ; loc_17EE:
00001AD2                            .skippriority:
00001AD2 D201                       		add.b	d1,d1		; is the high palette line bit set?
00001AD4 6400                       		bcc.s	.skiphighpal	; if not, branch
00001AD6 5346                       		subq.w	#1,d6
00001AD8 0D05                       		btst	d6,d5
00001ADA 6700                       		beq.s	.skiphighpal
00001ADC 0643 4000                  		addi.w	#$4000,d3	; set second palette line bit
00001AE0                            ; loc_17FC:
00001AE0                            .skiphighpal:
00001AE0 D201                       		add.b	d1,d1		; is the low palette line bit set?
00001AE2 6400                       		bcc.s	.skiplowpal	; if not, branch
00001AE4 5346                       		subq.w	#1,d6
00001AE6 0D05                       		btst	d6,d5
00001AE8 6700                       		beq.s	.skiplowpal
00001AEA 0643 2000                  		addi.w	#$2000,d3	; set first palette line bit
00001AEE                            ; loc_180A:
00001AEE                            .skiplowpal:
00001AEE D201                       		add.b	d1,d1		; is the vertical flip flag set?
00001AF0 6400                       		bcc.s	.skipyflip	; if not, branch
00001AF2 5346                       		subq.w	#1,d6
00001AF4 0D05                       		btst	d6,d5
00001AF6 6700                       		beq.s	.skipyflip
00001AF8 0043 1000                  		ori.w	#$1000,d3	; set Y-flip bit
00001AFC                            ; loc_1818:
00001AFC                            .skipyflip:
00001AFC D201                       		add.b	d1,d1		; is the horizontal flip flag set?
00001AFE 6400                       		bcc.s	.skipxflip	; if not, branch
00001B00 5346                       		subq.w	#1,d6
00001B02 0D05                       		btst	d6,d5
00001B04 6700                       		beq.s	.skipxflip
00001B06 0043 0800                  		ori.w	#$800,d3	; set X-flip bit
00001B0A                            ; loc_1826:
00001B0A                            .skipxflip:
00001B0A 3205                       		move.w	d5,d1
00001B0C 3E06                       		move.w	d6,d7
00001B0E 9E4D                       		sub.w	a5,d7		; subtract length in bits of inline copy value
00001B10 6400                       		bcc.s	.enoughbits	; branch if a new word doesn't need to be read
00001B12 3C07                       		move.w	d7,d6
00001B14 0646 0010                  		addi.w	#16,d6
00001B18 4447                       		neg.w	d7		; calculate bit deficit
00001B1A EF69                       		lsl.w	d7,d1		; and make space for that many bits
00001B1C 1A10                       		move.b	(a0),d5		; get next byte
00001B1E EF3D                       		rol.b	d7,d5		; and rotate the required bits into the lowest positions
00001B20 DE47                       		add.w	d7,d7
00001B22 CA7B 7000                  		and.w	EniDec_Masks-2(pc,d7.w),d5
00001B26 D245                       		add.w	d5,d1		; combine upper bits with lower bits
00001B28                            ; loc_1844:
00001B28                            .maskvalue:
00001B28 300D                       		move.w	a5,d0		; get length in bits of inline copy value
00001B2A D040                       		add.w	d0,d0
00001B2C C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; mask value appropriately
00001B30 D243                       		add.w	d3,d1		; add starting art tile
00001B32 1A18                       		move.b	(a0)+,d5
00001B34 E14D                       		lsl.w	#8,d5
00001B36 1A18                       		move.b	(a0)+,d5	; get next word
00001B38 4E75                       		rts	
00001B3A                            ; ===========================================================================
00001B3A                            ; loc_1856:
00001B3A                            .enoughbits:
00001B3A 6700                       		beq.s	.justenough	; if the word has been exactly exhausted, branch
00001B3C EE69                       		lsr.w	d7,d1	; get inline copy value
00001B3E 300D                       		move.w	a5,d0
00001B40 D040                       		add.w	d0,d0
00001B42 C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; and mask it appropriately
00001B46 D243                       		add.w	d3,d1	; add starting art tile
00001B48 300D                       		move.w	a5,d0
00001B4A 6000                       		bra.s	EniDec_FetchByte
00001B4C                            ; ===========================================================================
00001B4C                            ; loc_1868:
00001B4C                            .justenough:
00001B4C 7C10                       		moveq	#16,d6	; reset shift value
00001B4E 60D8                       		bra.s	.maskvalue
00001B50                            ; ===========================================================================
00001B50                            ; word_186C:
00001B50                            EniDec_Masks:
00001B50 0001 0003 0007 000F        		dc.w	 1,    3,    7,   $F
00001B58 001F 003F 007F 00FF        		dc.w   $1F,  $3F,  $7F,  $FF
00001B60 01FF 03FF 07FF 0FFF        		dc.w  $1FF, $3FF, $7FF, $FFF
00001B68 1FFF 3FFF 7FFF FFFF        		dc.w $1FFF,$3FFF,$7FFF,$FFFF
00001B70                            
00001B70                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001B70                            
00001B70                            ; sub_188C:
00001B70                            EniDec_FetchByte:
00001B70 9C40                       		sub.w	d0,d6	; subtract length of current entry from shift value so that next entry is read next time around
00001B72 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
00001B76 6400                       		bhs.s	.locret	; if not, branch
00001B78 5046                       		addq.w	#8,d6
00001B7A E145                       		asl.w	#8,d5
00001B7C 1A18                       		move.b	(a0)+,d5
00001B7E                            .locret:
00001B7E 4E75                       		rts	
00001B80                            ; End of function EniDec_FetchByte
00001B80                            ; End of function EniDec_FetchByte
00001B80                            		include "_inc\Kosinski Decompression.asm"
00001B80                            ; ---------------------------------------------------------------------------
00001B80                            ; Kosinski decompression algorithm
00001B80                            
00001B80                            ; input:
00001B80                            ;	a0 = source address
00001B80                            ;	a1 = destination address
00001B80                            
00001B80                            ; usage:
00001B80                            ;	lea	(source).l,a0
00001B80                            ;	lea	(destination).l,a1
00001B80                            ;	bsr.w	KosDec
00001B80                            ; ---------------------------------------------------------------------------
00001B80                            
00001B80                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001B80                            
00001B80                            
00001B80                            KosDec:
00001B80                            
00001B80 558F                       		subq.l	#2,sp	; make space for 2 bytes on the stack
00001B82 1F58 0001                  		move.b	(a0)+,1(sp)
00001B86 1E98                       		move.b	(a0)+,(sp)
00001B88 3A17                       		move.w	(sp),d5	; get first description field
00001B8A 780F                       		moveq	#$F,d4	; set to loop for 16 bits
00001B8C                            
00001B8C                            Kos_Loop:
00001B8C E24D                       		lsr.w	#1,d5	; shift bit into the c flag
00001B8E 40C6                       		move	sr,d6
00001B90 51CC 0000                  		dbf	d4,.chkbit
00001B94 1F58 0001                  		move.b	(a0)+,1(sp)
00001B98 1E98                       		move.b	(a0)+,(sp)
00001B9A 3A17                       		move.w	(sp),d5
00001B9C 780F                       		moveq	#$F,d4
00001B9E                            
00001B9E                            	.chkbit:
00001B9E 44C6                       		move	d6,ccr	; was the bit set?
00001BA0 6400                       		bcc.s	Kos_RLE	; if not, branch
00001BA2                            
00001BA2 12D8                       		move.b	(a0)+,(a1)+ ; copy byte as-is
00001BA4 60E6                       		bra.s	Kos_Loop
00001BA6                            ; ===========================================================================
00001BA6                            
00001BA6                            Kos_RLE:
00001BA6 7600                       		moveq	#0,d3
00001BA8 E24D                       		lsr.w	#1,d5	; get next bit
00001BAA 40C6                       		move	sr,d6
00001BAC 51CC 0000                  		dbf	d4,.chkbit
00001BB0 1F58 0001                  		move.b	(a0)+,1(sp)
00001BB4 1E98                       		move.b	(a0)+,(sp)
00001BB6 3A17                       		move.w	(sp),d5
00001BB8 780F                       		moveq	#$F,d4
00001BBA                            
00001BBA                            	.chkbit:
00001BBA 44C6                       		move	d6,ccr	; was the bit set?
00001BBC 6500                       		bcs.s	Kos_SeparateRLE ; if yes, branch
00001BBE                            
00001BBE E24D                       		lsr.w	#1,d5	; shift bit into the x flag
00001BC0 51CC 0000                  		dbf	d4,.loop1
00001BC4 1F58 0001                  		move.b	(a0)+,1(sp)
00001BC8 1E98                       		move.b	(a0)+,(sp)
00001BCA 3A17                       		move.w	(sp),d5
00001BCC 780F                       		moveq	#$F,d4
00001BCE                            
00001BCE                            	.loop1:
00001BCE E353                       		roxl.w	#1,d3	; get high repeat count bit
00001BD0 E24D                       		lsr.w	#1,d5
