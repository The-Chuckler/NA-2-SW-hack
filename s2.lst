0001BB8C                            ; ===========================================================================
0001BB8C                            ; ---------------------------------------------------------------------------
0001BB8C                            ; This seems to be a subroutine that would've shifted the background blocks
0001BB8C                            ; of Chemical Plant Zone once the player reached a certain X position,
0001BB8C                            ; lasting exactly two screens. This can also be found in the final at
0001BB8C                            ; $40200 in the ROM, with the only difference being its level ID, which
0001BB8C                            ; was updated to match Chemical Plant's final ID ($0D instead of 02)
0001BB8C                            ;
0001BB8C                            ; To see the effect for yourself, add a branch to it at the
0001BB8C                            ; start of LoadTilesAsYouMove and change $FFFF7500/$FFFF7D00 to
0001BB8C                            ; $FFFF0000/$FFFF0800 (to make it more visible)
0001BB8C                            ; ---------------------------------------------------------------------------
0001BB8C                            
0001BB8C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0001BB8C                            
0001BB8C                            
0001BB8C                            ; sub_1AC1E: ShiftCPZBackground:
0001BB8C 0C38 0002 FE10             		cmpi.b	#2,(Current_Zone).w	; is this Chemical Plant Zone?
0001BB92 6700                       		beq.s	loc_1AC28		; if yes, branch
0001BB94                            
0001BB94                            locret_1AC26:
0001BB94 4E75                       		rts
0001BB96                            ; ===========================================================================
0001BB96                            ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
0001BB96                            ; left and the last block in each row (chunk $ED/$FD) to the beginning
0001BB96                            ; i.e. rotates the blocks to the left by one
0001BB96                            
0001BB96                            loc_1AC28:
0001BB96 3038 EE00                  		move.w	($FFFFEE00).w,d0
0001BB9A 0C40 1940                  		cmpi.w	#$1940,d0
0001BB9E 65F4                       		bcs.s	locret_1AC26
0001BBA0 0C40 1F80                  		cmpi.w	#$1F80,d0
0001BBA4 64EE                       		bcc.s	locret_1AC26
0001BBA6 5338 F721                  		subq.b	#1,($FFFFF721).w
0001BBAA 6AE8                       		bpl.s	locret_1AC26
0001BBAC 11FC 0007 F721             		move.b	#7,($FFFFF721).w
0001BBB2 11FC 0001 F720             		move.b	#1,($FFFFF720).w
