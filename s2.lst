0000D762 41F8 B000                  		lea	($FFFFB000).w,a0
0000D766 7E7F                       		moveq	#$7F,d7			; run the first $80 objects out of levels
0000D768 7000                       		moveq	#0,d0
0000D76A 0C38 0006 B024             		cmpi.b	#6,($FFFFB000+routine).w	; is Sonic dead?
0000D770 6400                       		bcc.s	RunObjectsWhenPlayerIsDead	; if yes, branch
0000D772                            
0000D772                            ; ---------------------------------------------------------------------------
0000D772                            ; This is THE place where each individual object's code gets called from
0000D772                            ; ---------------------------------------------------------------------------
0000D772                            
0000D772                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000D772                            
0000D772                            ; sub_CB44:
0000D772                            RunObject:
0000D772 1010                       		move.b	(a0),d0		; get the object's ID
0000D774 6700                       		beq.s	loc_CB54	; if it's obj00, skip it
0000D776 D040                       		add.w	d0,d0
0000D778 D040                       		add.w	d0,d0	; d0 = object ID * 4
0000D77A 227B 0000                  		movea.l	Obj_Index-4(pc,d0.w),a1	; load the address of the object's code
0000D77E 4E91                       		jsr	(a1)	; dynamic call! to one of the the entries in Obj_Index
0000D780 7000                       		moveq	#0,d0
0000D782                            
0000D782                            loc_CB54:
0000D782 41E8 0040                  		lea	$40(a0),a0	; load obj address
0000D786 51CF FFEA                  		dbf	d7,RunObject
0000D78A 4E75                       		rts
0000D78C                            ; ---------------------------------------------------------------------------
0000D78C                            ; this skips certain objects to make enemies and things pause when Sonic dies
0000D78C                            ; loc_CB5E:
0000D78C                            RunObjectsWhenPlayerIsDead:
0000D78C 7E1F                       		moveq	#$1F,d7
0000D78E 61E2                       		bsr.s	RunObject
0000D790 7E5F                       		moveq	#$5F,d7
0000D792                            
0000D792                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000D792                            
0000D792                            ; loc_CB64:
0000D792                            RunObjectsDisplayOnly:
0000D792 7000                       		moveq	#0,d0
0000D794 1010                       		move.b	(a0),d0		; get the object's ID
0000D796 6700                       		beq.s	loc_CB74	; if it's obj00, skip it
0000D798 4A28 0001                  		tst.b	1(a0)		; should we render it?
0000D79C 6A00                       		bpl.s	loc_CB74	; if not, skip it
0000D79E 6100 0000                  		bsr.w	DisplaySprite
0000D7A2                            
0000D7A2                            loc_CB74:
0000D7A2 41E8 0040                  		lea	$40(a0),a0	; load obj address
0000D7A6 51CF FFEA                  		dbf	d7,RunObjectsDisplayOnly
0000D7AA 4E75                       		rts
0000D7AC                            ; End of function RunObjects
